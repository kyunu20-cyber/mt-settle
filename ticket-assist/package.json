{
  "name": "ticket-assist",
  "private": true,
  "version": "0.1.0",
  "description": "티켓 예매 보조 프로그램 — 공통 엔진 + 사이트별 Adapter + 대시보드 + 모의 예매 사이트",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "next": "16.4.6",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
